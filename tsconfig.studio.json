{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/main.tsx",
    "src/witchcraft/**/*",
    "src/openhiggsfield/**/*",
    "src/generation/**/*",
    "vite.config.ts",
    "worker/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
