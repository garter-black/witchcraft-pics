{
  "name": "witchcraft-studio-v1",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/media/*",
      "/auth/*"
    ]
  },
  "vars": {
    "HF_API_BASE_URL": "https://api.higgsfield.ai"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "witchcraft-studio-media"
    }
  ],
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "4126",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}